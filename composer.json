{
  "name": "ez-php/metrics-otlp",
  "version": "2.7.1",
  "description": "Exports ez-php/metrics counters, gauges and histograms as OTLP/HTTP JSON (delta temporality) to an OpenTelemetry collector",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["metrics", "opentelemetry", "otlp", "observability", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/metrics-otlp",
  "support": {
    "issues": "https://github.com/ez-php/metrics-otlp/issues",
    "source": "https://github.com/ez-php/metrics-otlp"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.7.0",
    "ez-php/metrics": "^2.7.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.7.0",
    "ez-php/testing-application": "^2.7.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\MetricsOtlp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
